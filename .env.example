# Copy this file to .env and fill in your keys.
# Never commit .env to Git!

# Get football-data.org key: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_key_here

# Get balldontlie.io key: https://app.balldontlie.io/
BALLDONTLIE_TOKEN=your_key_here

# Optional — TheSportsDB (Inter Miami / national teams). Defaults to the free key "123".
# THESPORTSDB_KEY=

# Get Groq key (free): https://console.groq.com/keys — used by the legacy main.py only
GROQ_API_KEY=gsk_your_key_here
